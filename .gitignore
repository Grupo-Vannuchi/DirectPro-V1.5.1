# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# materiais de venda (nao vao para o repo nem para o ZIP)
entrega/
.claude/

# Estado interno de ferramenta de agente — nao e codigo do projeto
/.superpowers/

# Rascunho de execucao de planos (superpowers) — nao versionado
